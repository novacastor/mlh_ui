# --- Recommended local dev (avoids CORS): same-origin requests via Vite proxy ---
# Requests go to /api/... on the dev server; vite.config.ts proxies to your backend.
VITE_API_BASE_URL=/api

# Where the proxy forwards (your FastAPI / backend listen address)
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# --- Alternative: call the API directly (backend MUST send Access-Control-Allow-Origin for http://localhost:5173) ---
# VITE_API_BASE_URL=http://127.0.0.1:8000
# (omit VITE_DEV_PROXY_TARGET or leave proxy unused)

# Enable WebSocket stream for live updates (falls back to polling if false or connection fails)
VITE_ENABLE_WS=true
